<Window x:Class="BattleshipClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Battleship Multiplayer"
        Width="980" Height="740"
        MinWidth="860" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushBackground}"
        Closing="Window_Closing">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>  <!-- Panou plasare nave -->
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>     <!-- Grile + centru -->
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>  <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- ═══ HEADER ═══ -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       x:Name="TxtTitle"
                       Text="⚓ BATTLESHIP"
                       FontSize="22" FontWeight="Bold"
                       Foreground="{StaticResource BrushHighlight}"
                       VerticalAlignment="Center"/>

            <Button Grid.Column="1"
                    Content="💬 Chat"
                    Style="{StaticResource SecondaryButton}"
                    Padding="14,8"
                    Click="BtnChat_Click"/>

            <Button Grid.Column="3"
                    Content="↻ Rotire"
                    x:Name="BtnRotate"
                    Style="{StaticResource SecondaryButton}"
                    Padding="14,8"
                    Visibility="Collapsed"
                    Click="BtnRotate_Click"/>
        </Grid>

        <!-- ═══ PANOU PLASARE NAVE ═══ -->
        <Border Grid.Row="2"
                x:Name="PlacementPanel"
                Background="{StaticResource BrushSurface}"
                CornerRadius="8"
                Padding="16,12"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="PLASEAZĂ NAVELE"
                               FontSize="12" FontWeight="Bold"
                               Foreground="{StaticResource BrushTextDim}"
                               Margin="0,0,0,8"/>
                    <ItemsControl x:Name="ShipList"/>
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtPlacementInstruction"
                               Text="Click pe grila ta pentru a plasa nava"
                               FontSize="14"
                               Foreground="{StaticResource BrushText}"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="TxtCurrentShip"
                               Text=""
                               FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource BrushHighlight}"
                               Margin="0,6,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="4" VerticalAlignment="Center">
                    <TextBlock Text="Direcție:" Foreground="{StaticResource BrushTextDim}" FontSize="12"/>
                    <TextBlock x:Name="TxtDirection"
                               Text="→ Orizontal"
                               FontSize="14" FontWeight="Bold"
                               Foreground="{StaticResource BrushShip}"
                               Margin="0,4,0,0"/>
                    <TextBlock Text="(R pentru rotire)"
                               FontSize="11"
                               Foreground="{StaticResource BrushTextDim}"
                               Margin="0,4,0,0"/>
                    <Button x:Name="BtnRandomPlace"
                            Content="🎲 Plasare aleatorie"
                            Style="{StaticResource SecondaryButton}"
                            FontSize="12"
                            Padding="10,5"
                            Margin="0,10,0,0"
                            Click="BtnRandomPlace_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ GRILE + CENTRU ═══ -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── Grila proprie ── -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           x:Name="TxtMyGridLabel"
                           Text="GRILA TA"
                           FontSize="13" FontWeight="Bold"
                           Foreground="{StaticResource BrushTextDim}"
                           HorizontalAlignment="Center"/>

                <Border Grid.Row="2"
                        Background="{StaticResource BrushSurface}"
                        CornerRadius="8"
                        Padding="8">
                    <UniformGrid x:Name="MyGrid" Rows="10" Columns="10"/>
                </Border>

                <TextBlock Grid.Row="4"
                           x:Name="TxtMyStats"
                           Text=""
                           FontSize="11"
                           Foreground="{StaticResource BrushTextDim}"
                           HorizontalAlignment="Center"/>
            </Grid>

            <!-- ── Coloana centrală: timer, VS, jurnal ── -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>   <!-- Timer -->
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>   <!-- VS -->
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="*"/>      <!-- Jurnal atacuri -->
                </Grid.RowDefinitions>

                <!-- Timer panel -->
                <StackPanel Grid.Row="0"
                            x:Name="TimerPanel"
                            HorizontalAlignment="Center"
                            Visibility="Collapsed">
                    <TextBlock x:Name="TxtTimer"
                               Text="30"
                               FontSize="34" FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource BrushSuccess}"/>
                    <!-- Bara de progres custom -->
                    <Grid Width="90" Height="5" Margin="0,4,0,0">
                        <Rectangle Fill="#1A2A44" RadiusX="2" RadiusY="2"/>
                        <Rectangle x:Name="TimerBarFill"
                                   Fill="{StaticResource BrushSuccess}"
                                   RadiusX="2" RadiusY="2"
                                   HorizontalAlignment="Left"
                                   Width="90"/>
                    </Grid>
                    <TextBlock x:Name="TxtTimerLabel"
                               Text="RÂNDUL TĂU"
                               FontSize="9" FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource BrushTextDim}"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <!-- VS -->
                <TextBlock Grid.Row="2"
                           Text="VS"
                           FontSize="16" FontWeight="Bold"
                           Foreground="{StaticResource BrushTextDim}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                <!-- Jurnal atacuri -->
                <Border Grid.Row="4"
                        x:Name="LogBorder"
                        Background="{StaticResource BrushSurface}"
                        CornerRadius="6"
                        Padding="6,6"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="5"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="ATACURI"
                                   FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource BrushTextDim}"
                                   HorizontalAlignment="Center"/>

                        <ScrollViewer Grid.Row="2"
                                      x:Name="LogScroll"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="AttackLog"/>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- ── Grila inamicului ── -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           x:Name="TxtEnemyGridLabel"
                           Text="GRILA INAMICULUI"
                           FontSize="13" FontWeight="Bold"
                           Foreground="{StaticResource BrushTextDim}"
                           HorizontalAlignment="Center"/>

                <Border Grid.Row="2"
                        Background="{StaticResource BrushSurface}"
                        CornerRadius="8"
                        Padding="8">
                    <UniformGrid x:Name="EnemyGrid" Rows="10" Columns="10"/>
                </Border>

                <TextBlock Grid.Row="4"
                           x:Name="TxtEnemyStats"
                           Text=""
                           FontSize="11"
                           Foreground="{StaticResource BrushTextDim}"
                           HorizontalAlignment="Center"/>
            </Grid>
        </Grid>

        <!-- ═══ STATUS BAR ═══ -->
        <Border Grid.Row="6"
                Background="{StaticResource BrushSurface}"
                CornerRadius="6"
                Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           x:Name="TxtStatus"
                           Text="Conectat. Aștept al doilea jucător..."
                           FontSize="13"
                           Foreground="{StaticResource BrushText}"
                           VerticalAlignment="Center"/>

                <Button Grid.Column="1"
                        x:Name="BtnRematch"
                        Content="🔁 Joacă din nou"
                        Style="{StaticResource PrimaryButton}"
                        Padding="14,6"
                        Visibility="Collapsed"
                        Click="BtnRematch_Click"/>

                <TextBlock Grid.Column="3"
                           x:Name="TxtTurn"
                           Text=""
                           FontSize="13" FontWeight="Bold"
                           Foreground="{StaticResource BrushSuccess}"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
