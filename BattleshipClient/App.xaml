<Application x:Class="BattleshipClient.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="ConnectDialog.xaml">
    <Application.Resources>

        <!-- ═══════════════════════════════════════════
             Culori globale
        ═══════════════════════════════════════════ -->
        <Color x:Key="ColorBackground">#1a1a2e</Color>
        <Color x:Key="ColorSurface">#16213e</Color>
        <Color x:Key="ColorAccent">#0f3460</Color>
        <Color x:Key="ColorHighlight">#e94560</Color>
        <Color x:Key="ColorText">#eaeaea</Color>
        <Color x:Key="ColorTextDim">#888888</Color>
        <Color x:Key="ColorWater">#1a3a5c</Color>
        <Color x:Key="ColorShip">#4a9eda</Color>
        <Color x:Key="ColorHit">#e94560</Color>
        <Color x:Key="ColorMiss">#555577</Color>
        <Color x:Key="ColorSunk">#8b0000</Color>
        <Color x:Key="ColorSuccess">#2ecc71</Color>

        <SolidColorBrush x:Key="BrushBackground"  Color="{StaticResource ColorBackground}"/>
        <SolidColorBrush x:Key="BrushSurface"     Color="{StaticResource ColorSurface}"/>
        <SolidColorBrush x:Key="BrushAccent"      Color="{StaticResource ColorAccent}"/>
        <SolidColorBrush x:Key="BrushHighlight"   Color="{StaticResource ColorHighlight}"/>
        <SolidColorBrush x:Key="BrushText"        Color="{StaticResource ColorText}"/>
        <SolidColorBrush x:Key="BrushTextDim"     Color="{StaticResource ColorTextDim}"/>
        <SolidColorBrush x:Key="BrushWater"       Color="{StaticResource ColorWater}"/>
        <SolidColorBrush x:Key="BrushShip"        Color="{StaticResource ColorShip}"/>
        <SolidColorBrush x:Key="BrushHit"         Color="{StaticResource ColorHit}"/>
        <SolidColorBrush x:Key="BrushMiss"        Color="{StaticResource ColorMiss}"/>
        <SolidColorBrush x:Key="BrushSunk"        Color="{StaticResource ColorSunk}"/>
        <SolidColorBrush x:Key="BrushSuccess"     Color="{StaticResource ColorSuccess}"/>

        <!-- ═══════════════════════════════════════════
             Stil buton principal
        ═══════════════════════════════════════════ -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background"   Value="{StaticResource BrushHighlight}"/>
            <Setter Property="Foreground"   Value="{StaticResource BrushText}"/>
            <Setter Property="FontFamily"   Value="Segoe UI"/>
            <Setter Property="FontSize"     Value="14"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="Padding"      Value="20,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#c73652"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#a02840"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#444"/>
                                <Setter Property="Foreground" Value="#888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Buton secundar (albastru) -->
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="{StaticResource BrushAccent}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1a5090"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ═══════════════════════════════════════════
             Stil TextBox
        ═══════════════════════════════════════════ -->
        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background"       Value="#0d1b2a"/>
            <Setter Property="Foreground"       Value="{StaticResource BrushText}"/>
            <Setter Property="BorderBrush"      Value="{StaticResource BrushAccent}"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="Padding"          Value="8,6"/>
            <Setter Property="FontFamily"       Value="Segoe UI"/>
            <Setter Property="FontSize"         Value="13"/>
            <Setter Property="CaretBrush"       Value="{StaticResource BrushText}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource BrushHighlight}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════════════════════════════════════
             Stil Label
        ═══════════════════════════════════════════ -->
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize"   Value="13"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize"   Value="13"/>
        </Style>

    </Application.Resources>
</Application>
