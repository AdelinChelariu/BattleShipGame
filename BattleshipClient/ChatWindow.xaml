<Window x:Class="BattleshipClient.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chat"
        Width="340" Height="500"
        ResizeMode="CanResize"
        WindowStartupLocation="Manual"
        Background="{StaticResource BrushBackground}"
        Closing="Window_Closing">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0"
                   Text="💬 Chat"
                   FontSize="16" FontWeight="Bold"
                   Foreground="{StaticResource BrushHighlight}"/>

        <!-- Lista mesaje -->
        <Border Grid.Row="2"
                Background="{StaticResource BrushSurface}"
                BorderBrush="{StaticResource BrushAccent}"
                BorderThickness="1"
                CornerRadius="6">
            <ScrollViewer x:Name="ScrollMessages"
                          VerticalScrollBarVisibility="Auto"
                          Padding="8">
                <StackPanel x:Name="MessagesPanel"/>
            </ScrollViewer>
        </Border>

        <!-- Input + buton -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     x:Name="TxtMessage"
                     Style="{StaticResource DarkTextBox}"
                     KeyDown="TxtMessage_KeyDown"
                     MaxLength="200"/>

            <Button Grid.Column="2"
                    Content="Trimite"
                    Style="{StaticResource PrimaryButton}"
                    Padding="14,8"
                    Click="BtnSend_Click"/>
        </Grid>
    </Grid>
</Window>
